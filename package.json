{
  "name": "hajime",
  "version": "3.0.0",
  "description": "A modern boilerplate for front-end projects.",
  "type": "module",
  "scripts": {
    "clean": "rimraf docs",
    "styles": "sass src/scss/style.scss docs/assets/css/style.css --style=compressed --load-path=node_modules && npm run styles:postcss",
    "styles:postcss": "postcss docs/assets/css/style.css -o docs/assets/css/style.css --no-map",
    "styles:dev": "sass src/scss/style.scss docs/assets/css/style.css --style=expanded --load-path=node_modules --embed-sources --source-map",
    "scripts": "node scripts/build-js.js",
    "images": "node scripts/images.js",
    "svg": "node scripts/svg.js",
    "sprite:svg": "node scripts/sprite-svg.js",
    "templates": "node scripts/templates.js",
    "build": "npm run clean && npm-run-all --parallel images svg sprite:svg styles scripts templates",
    "dev": "npm run clean && npm-run-all --parallel images svg sprite:svg styles:dev scripts templates && npm run serve",
    "serve": "browser-sync start --server docs --files 'docs/**/*.html' 'docs/assets/css/**/*.css' 'docs/assets/js/**/*.js' --no-open",
    "watch": "npm-run-all --parallel watch:*",
    "watch:styles": "sass src/scss/style.scss docs/assets/css/style.css --watch --style=expanded --load-path=node_modules --embed-sources --source-map",
    "watch:scripts": "node scripts/watch-js.js",
    "watch:templates": "node scripts/watch-templates.js",
    "watch:images": "chokidar 'src/media/img/**/*' -c 'npm run images'",
    "watch:svg": "chokidar 'src/media/svg/**/*' -c 'npm run svg'",
    "start": "npm-run-all dev --parallel serve watch",
    "lint": "npm-run-all --parallel lint:*",
    "lint:js": "eslint 'src/js/**/*.js' 'scripts/**/*.js'",
    "lint:scss": "stylelint 'src/scss/**/*.scss'",
    "lint:fix": "npm-run-all lint:js:fix lint:scss:fix",
    "lint:js:fix": "eslint 'src/js/**/*.js' 'scripts/**/*.js' --fix",
    "lint:scss:fix": "stylelint 'src/scss/**/*.scss' --fix",
    "gh-pages": "gh-pages -d docs",
    "deploy:staging": "node deploy/staging.js",
    "deploy:production": "npm run build && node deploy/production.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://j-cam@github.com/j-cam/hajime.git"
  },
  "keywords": [
    "boilerplate",
    "scss",
    "css",
    "html",
    "front-end"
  ],
  "author": "Jamie Campbell",
  "license": "GPL-2.0",
  "bugs": {
    "url": "https://github.com/j-cam/hajime/issues"
  },
  "homepage": "https://github.com/j-cam/hajime#readme",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "browser-sync": "^3.0.3",
    "chokidar": "^4.0.3",
    "chokidar-cli": "^3.0.0",
    "cssnano": "^7.0.6",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "gh-pages": "^6.2.0",
    "handlebars": "^4.7.8",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "sass": "^1.81.0",
    "sass-mq": "^6.0.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "svgo": "^3.3.2"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
